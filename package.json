{
  "name": "project-voyager-poc",
  "version": "0.1.0",
  "description": "Local MCP proof of concept for cross-AI work continuity.",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": "^20.19.0 || ^22.12.0 || >=24.0.0"
  },
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "build": "npm run clean && tsc -b",
    "setup:local": "npm run build && node scripts/setup-local.mjs",
    "dev": "tsc -b packages/core packages/mcp && tsx apps/server/src/index.ts",
    "start": "node apps/server/dist/index.js",
    "test": "npm run build && vitest run",
    "smoke": "npm run build && node scripts/smoke.mjs"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "tsx": "4.23.0",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  }
}
